#include<stdio.h>
int main()
{
  int num,i,tag=0;
  scanf("%d",&num);
  if(num<=1){
    printf("The number is not prime");
  }
  for(i=2;i<num;i++){
    if(num%i==0){
        tag=1;
        break;
    }

  }
  if(tag==1){
    printf("The number is not prime");
  }else{
   printf("The number is  prime");
   }
   return 0;
         }
